# ═══════════════════════════════════════
# 回覧板アプリ 環境変数サンプル
# .env.example をコピーして .env を作成してください
# ═══════════════════════════════════════

# ─── アプリ ─────────────────────────────
APP_ENV=development
PORT=8080

# ─── JWT ────────────────────────────────
# 本番環境では必ず強力なランダム文字列に変更してください
JWT_SECRET=change-me-in-production-use-strong-random-string

# アクセストークン有効期限（分）
ACCESS_TOKEN_EXPIRY_MIN=15

# リフレッシュトークン有効期限（日）
REFRESH_TOKEN_EXPIRY_DAYS=7

# ─── データベース ────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=circular_board

# ローカル開発用（Docker外から接続する場合）
DATABASE_URL=postgres://postgres:postgres@localhost:5432/circular_board?sslmode=disable

# ─── テスト用DB（db_testコンテナ固定認証情報） ────────
# cbuser / cbpassword は docker-compose.yml の db_test に固定設定されています
TEST_DATABASE_URL=postgres://cbuser:cbpassword@localhost:5433/circular_board_test?sslmode=disable

# ─── フロントエンド ──────────────────────
# Flutter --dart-define で使用するAPIのベースURL
# nginxを通す場合は http://localhost （ポート省略）
# バックエンド直アクセスの場合は http://localhost:8080
API_BASE_URL=http://localhost:8080

# ─── SendGrid（パスワードリセットメール送信） ────────
# SendGrid アカウントで取得した API キーを設定してください
# 未設定の場合、メール送信はスキップされ URL がログに出力されます（開発用）
SENDGRID_API_KEY=

# 送信元メールアドレス（SendGrid で検証済みのアドレスを使用）
SENDGRID_FROM_EMAIL=noreply@example.com

# ─── アプリのベース URL ──────────────────
# パスワードリセットメールに記載するリンクのベースURL
# 本番環境では実際のドメインに変更してください
APP_BASE_URL=http://localhost
